# === SPA & CO LUXURY — Variables d'environnement ===
# Copiez ce fichier en .env.local et remplissez les valeurs.
# Sur Vercel : Project Settings > Environment Variables.

# URL publique du site (utilisée pour SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://spa-co-luxury.vercel.app

# --- Supabase (backend : Auth, DB, Storage) — à brancher ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Emails transactionnels (Resend) ---
RESEND_API_KEY=

# --- Analytics / Tracking (optionnel) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Paiement (à activer plus tard) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Borne interactive (Smart Screen 32") ---
# Webhook optionnel vers le logiciel de caisse
BORNE_WEBHOOK_URL=

# Envoi automatique des demandes de la borne sur WhatsApp (+221 77 921 55 24).
# Option 1 : CallMeBot (gratuit — activation unique)
#   1. Depuis le +221 77 921 55 24, envoyer au +34 644 66 32 89 le message :
#      "I allow callmebot to send me messages"
#   2. CallMeBot répond avec une clé API
#   3. Collez-la ci-dessous
CALLMEBOT_APIKEY=

# Option 2 : gateway WhatsApp custom (Ultramsg, Wassenger, WhatsApp Business API)
# POST { to, message }
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=
